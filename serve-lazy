#!/usr/bin/env bash
# Like ./serve, but the Flask server only runs while it is being used.
#
# wakeproxy (wakeproxy/main.go) listens on the public port and keeps the server
# asleep. The first request starts ./serve on a private port and waits for it;
# after IDLE without requests the server is stopped and its RAM freed. Extra
# arguments go to wakeproxy (see: wakeproxy/wakeproxy -h).
set -euo pipefail
cd "$(dirname "$0")"

bin=wakeproxy/wakeproxy
if [[ ! -x $bin || -n $(find wakeproxy -name '*.go' -newer "$bin") ]]; then
  (cd wakeproxy && go build -trimpath -ldflags="-s -w" -o wakeproxy .)
fi

exec env GOMEMLIMIT=8MiB "$bin" \
  -listen "${HOST:-0.0.0.0}:${PORT:-3060}" \
  -backend "127.0.0.1:${BACKEND_PORT:-3070}" \
  -idle "${IDLE:-30m}" \
  "$@" -- ./serve
